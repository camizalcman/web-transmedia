# Crea una Web App en Firebase y copia aqui su configuracion publica.
# Si se dejan vacias, el proyecto funciona en modo demo con localStorage.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URLs publicas de los videos (CDN, Firebase Storage, etc.). Si se dejan
# vacias se usan los archivos de /public/videos.
# Video del noticiero del comienzo. Por defecto: /videos/VideoIntro.mp4
NEXT_PUBLIC_INTRO_VIDEO_URL=
# Video del final. Por defecto: /videos/VideoFin.mp4
NEXT_PUBLIC_END_VIDEO_URL=
