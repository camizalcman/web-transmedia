rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function writesOwnId() {
      return request.resource.data.userId == request.auth.uid;
    }

    // Partida de la portada (lib/cloudSave.js).
    match /games/{userId} {
      allow read, delete: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && writesOwnId()
        && request.resource.data.keys().hasOnly([
          'userId', 'authProvider', 'steps',
          'evidenceOrdered', 'phoneTaken', 'phoneUnlocked', 'contactTalked',
          'solved', 'lastSolvedAt',
          'unknownChat', 'updatedAt'
        ])
        && (!('steps' in request.resource.data)
          || (request.resource.data.steps is list && request.resource.data.steps.size() <= 20))
        && (!('solved' in request.resource.data) || request.resource.data.solved is bool)
        && (!('unknownChat' in request.resource.data)
          || (request.resource.data.unknownChat is map
            && request.resource.data.unknownChat.messages is list
            && request.resource.data.unknownChat.messages.size() <= 400));
    }

    // Perfil de cada jugador (lib/cloudSave.js).
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && writesOwnId();
    }
  }
}
